<UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/Mecaniques/Enemy_AI/AI_Tool/NodeViewStyle.uss?fileID=7433441132597879392&amp;guid=089f28516598fc747b848115472fdb92&amp;type=3#NodeViewStyle"/>
    <ui:VisualElement name="node-border">
        <ui:VisualElement name="title" style="flex-direction: row; justify-content: space-between;">
            <ui:Label name="title-label" text="SequencerNode" class="unity-text-element unity-label"/>
        </ui:VisualElement>
        <ui:VisualElement name="divider" class="horizontal"/>
        <ui:ProgressBar value="22" title="my-progress" name="ProgressBar"/>
        <ui:VisualElement name="contents">
            <ui:VisualElement name="top">
                <ui:VisualElement name="input"/>
                <ui:VisualElement name="divider" class="vertical"/>
                <ui:VisualElement name="output"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="selection-border"/>
</UXML>
