  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogues_ca
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ca
  m_SharedData: {fileID: 11400000, guid: 5c61bd76b41291441820f8fa69e498a3, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 8179937280
    m_Localized: "Benvingut a ANTlANTis, un regne de formigues on explorar, cr\xE9ixer,
      crear i combatre fins a al\xE7ar-se amb la vict\xF2ria."
    m_Metadata:
      m_Items: []
  - m_Id: 3697082888192
    m_Localized: "Haur\xE0s d'anar millorant el teu formiguer i les seves sales interiors
      per avan\xE7ar d'era."
    m_Metadata:
      m_Items: []
  - m_Id: 637314045833216
    m_Localized: "Comen\xE7a per generar ous, serveixen per a construir i produir
      formigues. Es produeixen a la cambra de la reina. Construeix-ne una!"
    m_Metadata:
      m_Items: []
  - m_Id: 637317124452352
    m_Localized: "Per accedir al formiguer fes doble clic sobre el monticle. Una
      vegada dins, obre el men\xFA de construcci\xF3 prement els maons i selecciona
      un t\xFAnel que connectar\xE0 l'entrada amb la cambra de la reina."
    m_Metadata:
      m_Items: []
  - m_Id: 647350776229888
    m_Localized: "Per \xFAltim, selecciona la cambra de la reina i connecta-la al
      t\xFAnel."
    m_Metadata:
      m_Items: []
  - m_Id: 647402487803904
    m_Localized: "Genial, ara es produiran ous a poc a poc; tot i aix\xED, per construir
      les altres cambres necessitar\xE0s materials de construcci\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 647450831351808
    m_Localized: "Surt del formiguer fent doble clic a l'entrada, selecciona les
      formigues exploradores que tens a l'exterior i envia-les a explorar el mapa
      i a recol\xB7lectar recursos dels nombrosos naufragis que hi ha al voltant."
    m_Metadata:
      m_Items: []
  - m_Id: 6937869567389696
    m_Localized: "Una vegada tornin i tinguis suficients materials, construeix una
      cambra de cria. Recorda connectar les cambres amb t\xFAnels perqu\xE8 les teves
      formigues puguin moure's per dins del formiguer."
    m_Metadata:
      m_Items: []
  - m_Id: 6937910201806848
    m_Localized: "Ara que tens una cambra de cria, fes doble clic sobre ella per
      obrir el men\xFA de creaci\xF3 i crear formigues. Aquestes t'ajudaran a gestionar
      el formiguer, explorar, lluitar i defensar-te."
    m_Metadata:
      m_Items: []
  - m_Id: 6938034118324224
    m_Localized: "Pots pausar el joc usant les tecles ESC i P. Des del men\xFA de
      pausa pots accedir als controls per a recordar-los, al men\xFA de configuraci\xF3
      per a editar-la i a l'inici. Vigila que si no guardes la partida despr\xE9s
      perdr\xE0s tot el teu progr\xE9s."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
