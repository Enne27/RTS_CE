  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogues_ca
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ca
  m_SharedData: {fileID: 11400000, guid: 5c61bd76b41291441820f8fa69e498a3, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 8179937280
    m_Localized: "Benvingut a ANTlANTis, un regne de formigues on explorar, cr\xE9ixer,
      crear i combatre fins a al\xE7ar-se amb la vict\xF2ria."
    m_Metadata:
      m_Items: []
  - m_Id: 3697082888192
    m_Localized: "Haur\xE0s d'anar millorant el teu formiguer i les seves sales interiors
      per a avan\xE7ar d'era."
    m_Metadata:
      m_Items: []
  - m_Id: 637314045833216
    m_Localized: "Entra en el teu formiguer fent doble clic sobre el monticle per
      a comen\xE7ar a construir. Primer necessitar\xE0s la cambra de la reina per
      a generar freses."
    m_Metadata:
      m_Items: []
  - m_Id: 637317124452352
    m_Localized: "Per a construir les altres cambres necessitar\xE0s recursos, no
      sols freses, tamb\xE9 materials de construcci\xF3. Envia a les formigues exploradores
      que tens a explorar el mapa i recol\xB7lectar."
    m_Metadata:
      m_Items: []
  - m_Id: 647350776229888
    m_Localized: "Una vegada que tornin i tinguis suficients, podr\xE0s construir
      les cambres de cria per a generar m\xE9s tipus de formigues que t'ajudin a
      gestionar el formiguer, explorar o lluitar i defensar-te."
    m_Metadata:
      m_Items: []
  - m_Id: 647402487803904
    m_Localized: "Pots construir usant les tecles 1, 2, 3 i 4 per a cada tipus de
      cambra o t\xFAnels. Tingues en compte que algunes d'aquestes tenen l\xEDmits
      de quantitat segons l'era en la qual estigui el teu imperi."
    m_Metadata:
      m_Items: []
  - m_Id: 647450831351808
    m_Localized: "Pots pausar el joc usant les tecles ESC i P. Aqu\xED pots accedir
      als controls per a recordar-los i tamb\xE9 a la configuraci\xF3. "
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
