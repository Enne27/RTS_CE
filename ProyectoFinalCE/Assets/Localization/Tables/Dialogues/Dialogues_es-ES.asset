  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogues_es-ES
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es-ES
  m_SharedData: {fileID: 11400000, guid: 5c61bd76b41291441820f8fa69e498a3, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 8179937280
    m_Localized: Bienvenido a ANTlANTis, un reino de hormigas donde explorar, crecer,
      crear y combatir hasta alzarse con la victoria.
    m_Metadata:
      m_Items: []
  - m_Id: 3697082888192
    m_Localized: "Deber\xE1s ir mejorando tu hormiguero y sus salas interiores para
      avanzar de era."
    m_Metadata:
      m_Items: []
  - m_Id: 637314045833216
    m_Localized: "Empieza por generar huevas, sirven para construir y producir hormigas.
      Se producen en la c\xE1mara de la reina. \xA1Construye una!"
    m_Metadata:
      m_Items: []
  - m_Id: 637317124452352
    m_Localized: "Para acceder al hormiguero haz doble click en el mont\xEDculo,
      una vez dentro, abre el men\xFA de construcci\xF3n pulsando en los ladrillos
      y selecciona un t\xFAnel que conectar\xE1 la entrada, con la c\xE1mara de la
      reina."
    m_Metadata:
      m_Items: []
  - m_Id: 647350776229888
    m_Localized: "Una vez vuelvan y tengas suficientes materiales, construye una
      c\xE1mara de cr\xEDa. Recuerda conectar las c\xE1maras con t\xFAneles para
      que tus hormigas puedan moverse por dentro del hormiguero."
    m_Metadata:
      m_Items: []
  - m_Id: 647402487803904
    m_Localized: "Genial, ahora se producir\xE1n huevas poco a poco, a\xFAn as\xED,
      para construir las otras c\xE1maras necesitar\xE1s materiales de construcci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 647450831351808
    m_Localized: "Sal del hormiguero haciendo doble click en la entrada, selecciona
      las hormigas exploradoras que tienes en el exterior y env\xEDalas a explorar
      el mapa y recolectar recursos de los numerosos naufragios que hay alrededor."
    m_Metadata:
      m_Items: []
  - m_Id: 6083593012101120
    m_Localized: "Ahora que tienes una c\xE1mara de cr\xEDa, haz doble clic sobre
      ella, para abrir el men\xFA de creaci\xF3n, y crear hormigas, \xE9stas te ayudar\xE1n
      a gestionar el hormiguero, explorar, luchar y defenderte."
    m_Metadata:
      m_Items: []
  - m_Id: 6083625710895104
    m_Localized: "Puedes pausar el juego usando las teclas ESC y P. Ah\xED, puedes
      acceder a los controles para recordarlos y editar la configuraci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 6735660584628224
    m_Localized: "Por \xFAltimo, selecciona la c\xE1mara de la reina, y conectala
      al t\xFAnel."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
