  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogues_es-ES
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es-ES
  m_SharedData: {fileID: 11400000, guid: 5c61bd76b41291441820f8fa69e498a3, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 8179937280
    m_Localized: Bienvenido a ANTlANTis, un reino de hormigas donde explorar, crecer,
      crear y combatir hasta alzarse con la victoria.
    m_Metadata:
      m_Items: []
  - m_Id: 3697082888192
    m_Localized: "Deber\xE1s ir mejorando tu hormiguero y sus salas interiores para
      avanzar de era."
    m_Metadata:
      m_Items: []
  - m_Id: 637314045833216
    m_Localized: "Entra en tu hormiguero haciendo doble clic sobre el mont\xEDculo
      para comenzar a construir. Primero necesitar\xE1s la c\xE1mara de la reina
      para generar huevas."
    m_Metadata:
      m_Items: []
  - m_Id: 637317124452352
    m_Localized: "Para construir las otras c\xE1maras necesitar\xE1s recursos, no
      solo huevas, tambi\xE9n materiales de construcci\xF3n. Env\xEDa a las hormigas
      exploradoras que tienes a explorar el mapa y recolectar."
    m_Metadata:
      m_Items: []
  - m_Id: 647350776229888
    m_Localized: "Una vez que vuelvan y tengas suficientes, podr\xE1s construir las
      c\xE1maras de cr\xEDa para generar m\xE1s tipos de hormigas que te ayuden a
      gestionar el hormiguero, explorar o luchar y defenderte."
    m_Metadata:
      m_Items: []
  - m_Id: 647402487803904
    m_Localized: "Puedes construir usando las teclas 1, 2, 3 y 4 para cada tipo de
      c\xE1mara o t\xFAneles. Ten en cuenta que algunas de estas tienen l\xEDmites
      de cantidad seg\xFAn la era en la que est\xE9 tu imperio."
    m_Metadata:
      m_Items: []
  - m_Id: 647450831351808
    m_Localized: "Puedes pausar el juego usando las teclas ESC y P. Ah\xED puedes
      acceder a los controles para recordarlos y tambi\xE9n a la configuraci\xF3n."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
