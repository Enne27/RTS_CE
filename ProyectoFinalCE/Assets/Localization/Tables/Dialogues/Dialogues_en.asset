  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogues_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 5c61bd76b41291441820f8fa69e498a3, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 8179937280
    m_Localized: Welcome to ANTlANTis, an ant kingdom where you can explore, grow,
      create, and fight your way to victory.
    m_Metadata:
      m_Items: []
  - m_Id: 3697082888192
    m_Localized: "\u200BYou will have to improve your anthill and its interior rooms
      to progress through the eras."
    m_Metadata:
      m_Items: []
  - m_Id: 637314045833216
    m_Localized: "\u200BStart by generating eggs; they are used to build and produce
      ants. They are produced in the queen's chamber. Build one!"
    m_Metadata:
      m_Items: []
  - m_Id: 637317124452352
    m_Localized: "\u200BTo access the anthill, double-click on the mound. Once inside,
      open the construction menu by clicking on the bricks and select a tunnel to
      connect the entrance to the queen's chamber."
    m_Metadata:
      m_Items: []
  - m_Id: 647350776229888
    m_Localized: "\u200BFinally, select the queen's chamber and connect it to the
      tunnel."
    m_Metadata:
      m_Items: []
  - m_Id: 647402487803904
    m_Localized: "\u200BGreat, now eggs will be produced gradually. Even so, you
      will need construction materials to build the other chambers."
    m_Metadata:
      m_Items: []
  - m_Id: 647450831351808
    m_Localized: "\u200BLeave the anthill by double-clicking on the entrance, select
      the scout ants you have outside, and send them to explore the map and gather
      resources from the numerous shipwrecks around."
    m_Metadata:
      m_Items: []
  - m_Id: 6937869567389696
    m_Localized: "\u200BOnce they return and you have enough materials, build a breeding
      chamber. Remember to connect the chambers with tunnels so your ants can move
      around inside the anthill."
    m_Metadata:
      m_Items: []
  - m_Id: 6937910201806848
    m_Localized: "\u200BNow that you have a breeding chamber, double-click on it
      to open the creation menu and breed ants; they will help you manage the anthill,
      explore, fight, and defend yourself."
    m_Metadata:
      m_Items: []
  - m_Id: 6938034118324224
    m_Localized: "\u200BYou can pause the game using the ESC and P keys. There, you
      can access the controls to review them, the settings menu to edit and to start
      menu. Look out! If you don't save the game then you'll lose all your progress."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
