  m_TableData:
  - m_Id: 16244449280
    m_Localized: Puesta constante de huevos para construir edificios, criar nuevas
      hormigas, mejorar construcciones, etc.
    m_Metadata:
      m_Items: []
  - m_Id: 18970746880
    m_Localized: Crea distintos tipos de hormigas.
    m_Metadata:
      m_Items: []
  - m_Id: 21265031168
    m_Localized: "Guarda comida y materiales de construcci\xF3n.\r\nProducci\xF3n
      constante de comida gracias a los hongos de la granja de hongos interna."
    m_Metadata:
      m_Items: []
  - m_Id: 345286429810688
    m_Localized: "Almacenamiento r\xE1pido de los materiales de construcci\xF3n y
      comida recolectados durante las exploraciones."
    m_Metadata:
      m_Items: []
  - m_Id: 5078495585353728
    m_Localized: "C\xE1mara de la reina"
    m_Metadata:
      m_Items: []
  - m_Id: 5078702922383360
    m_Localized: "C\xE1mara de cr\xEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 5078501423824896
    m_Localized: "C\xE1mara de almacenamiento"
    m_Metadata:
      m_Items: []
  - m_Id: 5079447906271232
    m_Localized: "Conecta las diferentes c\xE1maras para que las obreras puedan pasar."
    m_Metadata:
      m_Items: []
  - m_Id: 5079424665632768
    m_Localized: "T\xFAnel"
    m_Metadata:
      m_Items: []
  - m_Id: 5787047195033600
    m_Localized: "C\xE1mara de forrajeo"
    m_Metadata:
      m_Items: []
  - m_Id: 6134100100292608
    m_Localized: Lleno !
    m_Metadata:
      m_Items: []
  - m_Id: 5785351177879552
    m_Localized: "C\xE1mara de la reina: puesta de huevos que puedes gastar en construir
      edificios, criar nuevas hormigas, mejorar las construcciones, etc."
    m_Metadata:
      m_Items: []
  - m_Id: 5788548160274432
    m_Localized: "Almacenamiento y huerta de hongos: guarda la comida y los materiales
      de construcci\xF3n. Cada cierto tiempo se producir\xE1 comida gracias a los
      hongos que crecen aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 5788484306190336
    m_Localized: "C\xE1mara de cr\xEDa: para crear diferentes tipos de hormigas.
      Cada una necesita ciertos recursos para crecer, y tienen distintas habilidades.\r\nLas
      hormigas obreras no salen del hormiguero, pero se encargan de transportar materiales
      y vigilar dentro."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
