  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Buildings_es-ES
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es-ES
  m_SharedData: {fileID: 11400000, guid: de42bd94b24b0c54c8e83de18dd1f294, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16244449280
    m_Localized: "C\xE1mara de la reina: posta de huevos que podr\xE1s usar para
      las diferentes gestiones comerciales, como: construir edificios, criar nuevas
      hormigas, mejorar las construcciones, etc. "
    m_Metadata:
      m_Items: []
  - m_Id: 18970746880
    m_Localized: "C\xE1mara de cr\xEDa: aqu\xED podr\xE1s crear diferentes tipos
      de hormigas. Cada una necesita ciertos recursos para crecer y es mejor por
      circunstancias diferentes a las otras.\r\nLas hormigas obreras no saldr\xE1n
      del hormiguero, pero se encargar\xE1n de transportar materiales y vigilar dentro. "
    m_Metadata:
      m_Items: []
  - m_Id: 21265031168
    m_Localized: "Almacenamiento y huerta de hongos: se guarda la comida y los materiales
      de construcci\xF3n. Adem\xE1s, cada cierto tiempo se producir\xE1 comer gracias
      a los hongos que crecen en este tipo de c\xE1maras."
    m_Metadata:
      m_Items: []
  - m_Id: 345286429810688
    m_Localized: "C\xE1mara de forraje: las exploradoras llevar\xE1n all\xE1 los
      materiales de construcci\xF3n y comer recolectado durante las exploraciones,
      y las obreras se encargar\xE1n de transportarlo en las c\xE1maras de almacenamiento."
    m_Metadata:
      m_Items: []
  - m_Id: 5078495585353728
    m_Localized: "C\xE1mara de la reina"
    m_Metadata:
      m_Items: []
  - m_Id: 5078702922383360
    m_Localized: "C\xE1mara de cr\xEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 5078501423824896
    m_Localized: "C\xE1mara de almacenamiento"
    m_Metadata:
      m_Items: []
  - m_Id: 5079447906271232
    m_Localized: "Conecta las diferentes c\xE1maras para que las obreras puedan pasar."
    m_Metadata:
      m_Items: []
  - m_Id: 5079424665632768
    m_Localized: "T\xFAnel"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
