  m_TableData:
  - m_Id: 16244449280
    m_Localized: "Posta constant d\u2019ous per construir edificis, criar noves formigues,
      millorar construccions, etc."
    m_Metadata:
      m_Items: []
  - m_Id: 18970746880
    m_Localized: Crea diferents tipus de formigues.
    m_Metadata:
      m_Items: []
  - m_Id: 21265031168
    m_Localized: "Guarda menjar i materials de construcci\xF3. \r\nProducci\xF3 constant
      de menjar gr\xE0cies als fongs de la granja de fongs interna."
    m_Metadata:
      m_Items: []
  - m_Id: 345286429810688
    m_Localized: "Emmagatzematge r\xE0pid dels materials de construcci\xF3 i menjar
      recol\xB7lectats durant les exploracions."
    m_Metadata:
      m_Items: []
  - m_Id: 5078495585353728
    m_Localized: Cambra de la reina
    m_Metadata:
      m_Items: []
  - m_Id: 5078702922383360
    m_Localized: Cambra de cria
    m_Metadata:
      m_Items: []
  - m_Id: 5078501423824896
    m_Localized: Cambra d'emmagatzematge
    m_Metadata:
      m_Items: []
  - m_Id: 5079424665632768
    m_Localized: "T\xFAnel"
    m_Metadata:
      m_Items: []
  - m_Id: 5079447906271232
    m_Localized: "Connecta les diferents cambres perqu\xE8 passin les obreres."
    m_Metadata:
      m_Items: []
  - m_Id: 5787047195033600
    m_Localized: Cambra de farratge
    m_Metadata:
      m_Items: []
  - m_Id: 6134100100292608
    m_Localized: Ple !
    m_Metadata:
      m_Items: []
  - m_Id: 5785351177879552
    m_Localized: "Cambra de la reina: posta d\u2019ous que pots fer servir per construir
      edificis, criar noves formigues, millorar les construccions, etc."
    m_Metadata:
      m_Items: []
  - m_Id: 5788548160274432
    m_Localized: "Emmagatzematge i horta de fongs: guarda el menjar i els materials
      de construcci\xF3. Cada cert temps es produir\xE0 menjar gr\xE0cies als fongs
      que creixen aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 5788484306190336
    m_Localized: "Cambra de cria: per crear diferents tipus de formigues. Cadascuna
      necessita certs recursos per cr\xE9ixer, i tenen diverses funcions.\r\nLes
      formigues obreres no surten del formiguer, per\xF2 s'encarreguen de transportar
      materials i vigilar dins."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
