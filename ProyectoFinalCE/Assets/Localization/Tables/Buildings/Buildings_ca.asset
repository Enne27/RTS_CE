  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Buildings_ca
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ca
  m_SharedData: {fileID: 11400000, guid: de42bd94b24b0c54c8e83de18dd1f294, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16244449280
    m_Localized: "Cambra de la reina: posta d\u2019ous que podr\xE0s fer servir per
      a les diferents gestions comercials, com: construir edificis, criar noves formigues,
      millorar les construccions, etc."
    m_Metadata:
      m_Items: []
  - m_Id: 18970746880
    m_Localized: "Cambra de cria: aqu\xED podr\xE0s crear diferents tipus de formigues.
      Cadascuna necessita uns certs recursos per cr\xE9ixer i \xE9s millor per circumst\xE0ncies
      diferents a les altres.\r\nLes formigues obreres no sortiran del formiguer,
      per\xF2 s\u2019encarregaran de transportar materials i vigilar dintre.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 21265031168
    m_Localized: "Emmagatzematge i horta de fongs: es guarda el menjar i els materials
      de construcci\xF3. A m\xE9s, cada cert temps es produir\xE0 menjar gr\xE0cies
      als fongs que creixen en aquest tipus de cambres."
    m_Metadata:
      m_Items: []
  - m_Id: 345286429810688
    m_Localized: "Cambra de farratge: les exploradores portaran all\xE0 els materials
      de construcci\xF3 i menjar recol\xB7lectat durant les exploracions, i les obreres
      s\u2019encarregaran de transportar-lo a les cambres d\u2019emmagatzematge."
    m_Metadata:
      m_Items: []
  - m_Id: 5078495585353728
    m_Localized: Cambra de la reina
    m_Metadata:
      m_Items: []
  - m_Id: 5078702922383360
    m_Localized: Cambra de cria
    m_Metadata:
      m_Items: []
  - m_Id: 5078501423824896
    m_Localized: Cambra d'emmagatzematge
    m_Metadata:
      m_Items: []
  - m_Id: 5079424665632768
    m_Localized: "T\xFAnel"
    m_Metadata:
      m_Items: []
  - m_Id: 5079447906271232
    m_Localized: "Conecta les diferents cambres perqu\xE8 passin les obreres."
    m_Metadata:
      m_Items: []
  references:
    version: 2
